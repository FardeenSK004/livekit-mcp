# ==============================================================================
# LiveKit MCP Server Configuration
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Authentication Configuration (Mantra Auth OAuth 2.1 / Shared JWT)
AUTH_ENABLED=true
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
AUTH_SERVER_URL=http://localhost:3000
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=

# LKT Voice Agent & Telephony Service
LKT_API_BASE_URL=http://localhost:8081
LKT_API_TIMEOUT=15.0

# LiveKit Cloud Direct Credentials (Optional / Future direct integration)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
